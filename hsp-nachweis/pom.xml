  <build>
    <plugins>
      <plugin>
        <groupId>com.coderplus.maven.plugins</groupId>
        <artifactId>copy-rename-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <destinationFile>
                ${project.build.directory}/classes/META-INF/resources/js/erfassung.js
              </destinationFile>
              <sourceFile>${project.build.directory}/package/dist/erfassung.js</sourceFile>
            </configuration>
            <goals>
              <goal>copy</goal>
            </goals>
            <id>copy-file</id>
            <phase>compile</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <failOnError>true</failOnError>
              <followRedirects>true</followRedirects>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <retries>3</retries>
              <skipCache>true</skipCache>
              <unpack>true</unpack>
              <url>
                https://artefakt.dev.sbb.berlin/repository/sbb-npm-releases/hsp-erfassung/-/hsp-erfassung-2.0.0.tgz
              </url>
            </configuration>
            <goals>
              <goal>wget</goal>
            </goals>
            <id>download-erfassung</id>
            <phase>generate-sources</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.cleydyr</groupId>
        <artifactId>dart-sass-maven-plugin</artifactId>
        <configuration>
          <arch>x64</arch>
          <cachedFilesDirectory>${basedir}/src/sass-compiler</cachedFilesDirectory>
          <inputFolder>${basedir}/src/main/resources/META-INF/resources</inputFolder>
          <noSourceMap>true</noSourceMap>
          <!--style>COMPRESSED</style -->
          <os>linux</os>
          <outputFolder>${basedir}/src/main/resources/META-INF/resources</outputFolder>
          <quiet>false</quiet>
          <update>true</update>
          <version>${dart-sass-compiler.version}</version>
        </configuration>
        <executions>
          <execution>
            <id>generate-css-using-sass</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>compile-sass</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jandex</goal>
            </goals>
            <id>make-index</id>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>false</filtering>
      </testResource>
    </testResources>
  </build>

