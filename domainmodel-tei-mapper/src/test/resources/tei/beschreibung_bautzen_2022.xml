            <note type="text">
              <ref target="#bezwrk[0].6930">
                ‘Meißner Rechtsbuch’, Fragment
              </ref>
              <lb/>
              <lb/>
              (a.) 1ra Buch I, Cap. 29,1-2
              <lb/>
              <lb/>
              <quote>
                keyne
              </quote>
              [koste mer tragen noch vor]
              <quote>
                gebin von der kindir g
              </quote>
              [ud, si]
              <quote>
                erstate es on denne wi
              </quote>
              [der].
              <quote>
                Vnde ist lantrecht, wicbilde unde keyser recht.
              </quote>
              <quote>
                >
