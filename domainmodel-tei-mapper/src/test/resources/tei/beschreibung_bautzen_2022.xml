              <quote>
                habin. Distinctio prima.
              </quote>
              [Wer sin gud]
              <quote>
                vorkouft czu syme
              </quote>
              [liebe, seczt ad]
              <quote>
                dir lest so beschey
              </quote>
              [den]
              <quote>
                lich, w
              </quote>
              [a]
              <quote>
                n des nicht lenger were … – … >Distinctio secunda.
                <ref target="#5650[1].5666d">
                  Let ein man adir seczt us erblich gut a
                </ref>
              </quote>
              <ref target="#5650[1].5666d">
                [d]
              </ref>
              <quote>
                <ref target="#5650[1].5666d">
                  ir so getan gut, do
                </ref>
              </quote>
              [her]
              <quote>
                adir si
              </quote>
              [n]
              <quote>
                wip czins adir
              </quote>
              [anefal]
              <quote>
                an habin, das mag sin
              </quote>
              [wip]
              <lb/>
              <lb/>
              Editionen: Friedrich
              <hi rend="small-caps">
                Ortloff
